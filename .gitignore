# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — never commit secrets
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw source data for scripts/build-bible-data.mjs (large, fetched locally).
# The committed Q&A retrieval index under data/qa-index/ is the exception —
# it ships to production (Vercel deploys from git), so keep it tracked.
/data/*
!/data/qa-index/

# playwright artifacts
/test-results/
/playwright-report/
scripts/probe-*.mjs
scripts/shoot-*.mjs
dev-server.log
