# ----------------------------------------------------------------------------
# Hodos landing page — environment variables.
# Copy to .env.local and fill in. Never commit .env.local.
# ----------------------------------------------------------------------------

# Supabase (waitlist + feedback + accounts/cloud-sync backend)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server-only — must NEVER reach the client bundle
# Public anon (publishable) key — safe in the client. Set this to TURN ON real
# accounts + cloud sync (Supabase Auth) AND group map sharing / live
# collaboration (Realtime). Leave blank to stay local-first. Group sharing also
# needs migration 0005_groups.sql — see BACKEND_SETUP.md §4.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Salt for hashing client IPs (sha256(ip + secret + day)). Any long random string.
WAITLIST_RATE_LIMIT_SECRET=

# Canonical site URL (used for metadata, OG, robots, sitemap)
NEXT_PUBLIC_SITE_URL=https://hodos.app

# Plausible analytics — set to your verified domain to enable the script.
# Leave blank to disable analytics entirely (e.g. in local dev).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Feature flag — the /app canvas. "true" enables it; anything else 404s.
# Set to true on Vercel PREVIEW environments only until the v1 cutover.
NEXT_PUBLIC_HODOS_APP_ENABLED=

# Resend — beta invite emails (emails/beta-invite.tsx) + mass-email audience sync.
# Not needed to run the app. Get the key at resend.com → API Keys.
RESEND_API_KEY=
# Resend Audience to sync contacts into (scripts/sync-resend-audience.mjs).
# Create one at resend.com → Audiences; the id looks like a uuid. You compose &
# send newsletters to this audience as "Broadcasts" from the Resend dashboard.
RESEND_AUDIENCE_ID=

# Anthropic — powers the "Ask Scripture" canvas assistant (app/actions/ask-scripture.ts).
# Server-only — must NEVER reach the client bundle. Without it, authorship/biography
# questions still answer from curated metadata; topical answers are disabled.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8).
ANTHROPIC_QA_MODEL=claude-opus-4-8

# Tyndale NLT API (api.nlt.to) — powers the New Living Translation as a live,
# server-side-fetched version (lib/nlt.ts + app/api/nlt). Server-only — must
# NEVER reach the client bundle. Without it, NLT requests return 503 and the
# version simply fails to load; the bundled public-domain versions are unaffected.
NLT_API_KEY=
